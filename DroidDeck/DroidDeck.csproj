<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>kzcompanion.ico</ApplicationIcon>
    <AssemblyName>KZCompanion</AssemblyName>
    <RootNamespace>DroidDeck</RootNamespace>
    <Product>KZ Companion</Product>
    <Company>KZ Dev Studio</Company>
    <Description>KZ Companion - Windows agent (based on DroidDeck, Apache-2.0)</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="LocalStorage" Version="2.1.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4370.26" />
    <PackageReference Include="MQTTnet" Version="4.3.7.1207" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NLog" Version="6.0.4" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.4" />
    <PackageReference Include="NLog.Extensions.Logging" Version="5.0.0" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.2" />
    <PackageReference Include="System.Management" Version="10.0.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bandeja e janelas carregam o tamanho exato daqui (ver AppIcon.cs). -->
    <EmbeddedResource Include="kzcompanion.ico" LogicalName="DroidDeck.droiddeck.ico" />
    <!-- Um arquivo por idioma, os mesmos do app: o PC acha os idiomas por eles. -->
    <EmbeddedResource Include="..\app\assets\i18n\*.json" LogicalName="i18n.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <!-- TuyaCrypto e interno de proposito (ninguem fora do plugin deve montar assinatura),
         mas precisa ser testavel: e a unica peca do plugin que falha em silencio. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>DroidDeck.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="wwwroot\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Sem o index.html do configurador, "/" respondia 401 e a janela abria vazia. -->
  <Target Name="RequireWebBuild" BeforeTargets="PrepareForPublish">
    <Error Condition="!Exists('$(ProjectDir)wwwroot/index.html')" Text="wwwroot/index.html ausente: rode scripts/publish-windows.ps1 (ou scripts/deploy-web.ps1) antes de publicar." />
    <!-- wwwroot nao vai para o git e fica velho em silencio: um front-end sem o menu atual (ou com o deck antigo) nao e publicado. -->
    <PropertyGroup>
      <KzWebJs>$([System.IO.File]::ReadAllText('$(ProjectDir)wwwroot/main.dart.js'))</KzWebJs>
      <KzWebStale Condition="!$(KzWebJs.Contains('Integrations')) Or $(KzWebJs.Contains('Import from Stream Deck')) Or $(KzWebJs.Contains('Automations'))">true</KzWebStale>
    </PropertyGroup>
    <Error Condition="'$(KzWebStale)' == 'true'" Text="DroidDeck/wwwroot esta velho (sem Integrations, ou com o deck antigo). Rode scripts/publish-windows.ps1." />
  </Target>

</Project>
